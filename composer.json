{
    "name": "empresa/projeto-erp-etiquetas",
    "description": "Módulo complementar ao ERP: consulta de materiais (ESMATERI) e etiquetas com QR Code",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-oci8": "*",
        "ext-gd": "*",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "vlucas/phpdotenv": "^5.6",
        "endroid/qr-code": "^6.0",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
