# ============================================
# Configuração Docker - Módulo de Etiquetas (ERP)
# ============================================
# Copie para .env e troque as senhas: cp .env.docker.example .env

# Aplicação
APP_NAME="Etiquetas ERP"
APP_ENV=development
APP_DEBUG=true
TZ=America/Sao_Paulo

# Tamanho da etiqueta (mm) — ajustar ao rolo/folha da impressora
ETIQUETA_LARGURA_MM=100
ETIQUETA_ALTURA_MM=50

# Porta do nginx no host da VM (o projeto de chamados usa 8188)
WEB_HOST_PORT=8190

# --------------------------------------------
# Oracle
# --------------------------------------------
# Desenvolvimento: Oracle XE 21c (PDB XEPDB1).
# Validação/entrega: Oracle 19c (PDB ORCLPDB1) — trocar DB_SERVICE.
ORACLE_PASSWORD=TROQUE_SENHA_SYSTEM
# Porta exposta no host para ferramentas como SQL Developer/DBeaver
ORACLE_HOST_PORT=1521

DB_HOST=oracle
DB_PORT=1521
DB_SERVICE=XEPDB1

# Usuário da aplicação: só tem SELECT na ESMATERI (criado em
# docker/oracle/init/01-setup.sh). Sem aspas → o Oracle grava em maiúsculo.
DB_USER=ETIQUETAS_APP
DB_PASS=TROQUE_SENHA_APP

# Schema dono da ESMATERI. No ERP é "db_tst" (minúsculo = case-sensitive,
# sempre entre aspas no SQL). Na AWS o nome real provavelmente é outro.
DB_SCHEMA=db_tst
